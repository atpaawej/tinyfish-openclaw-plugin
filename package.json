{
  "name": "@tinyfish/openclaw-web-provider",
  "version": "0.1.0",
  "description": "TinyFish native web search and fetch providers for OpenClaw",
  "type": "module",
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": { "typebox": "^1.3.30" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": { "openclaw": ">=2026.9.5" },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": ">=2026.9.5", "minGatewayVersion": "2026.9.5" },
    "build": { "openclawVersion": "2026.9.5", "pluginSdkVersion": "2026.9.5" }
  }
}
